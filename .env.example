# ==============================================================================
# GDDES Environment Configuration Template
# Copy this file to .env and adjust variables as required
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=django-insecure-gddes-analysis-key-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web

# Server Port
PORT=8000

# Database Configuration (Optional: SQLite is used automatically when MySQL is empty)
MYSQL_HOST=
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db
MYSQL_PORT=3306
